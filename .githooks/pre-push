#!/bin/sh
# Refuses a push that names something private to the repository this one is
# developed beside (its task list, decision records, milestone and journey
# ids) or carries assistant attribution, in a commit message or an added
# line of any file but this one, and a push gitleaks finds a secret in.
# This repository is public, and a removed line stays in its history.
# Install once per clone: git config core.hooksPath .githooks
set -eu

internal='\bCUJ\b|\bADR-?[0-9]{2,4}\b|\bM[0-9]{2,3}(\.[0-9]+)?\b|TASKS\.md|SESSION_LOG|PROD-(PLAN|RESULTS|PROGRESS)|[Cc]ontrol[ -][Pp]lane|Co-Authored-By: Claude|Claude-Session:|Generated with \[Claude Code\]'

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
fail=0
while read -r _ local_sha _ remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	base=$remote_sha
	[ "$base" = "$zero" ] && base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
	range="$local_sha"
	[ -n "$base" ] && range="$base..$local_sha"
	if msgs=$(git log --format='%h %s%n%b' "$range" | grep -nE "$internal"); then
		echo "Error: a commit message being pushed names something private:" >&2
		echo "$msgs" | head -5 >&2
		fail=1
	fi
	added=$(git log -p --format='commit %h' "$range" -- . ':(exclude).githooks/pre-push' |
		awk '/^commit [0-9a-f]+$/ {c=$2} /^\+[^+]/ {print c": "$0}' | grep -E "$internal" || true)
	if [ -n "$added" ]; then
		echo "Error: lines being pushed name something private:" >&2
		echo "$added" | head -5 >&2
		fail=1
	fi
	if command -v gitleaks >/dev/null; then
		if ! gitleaks git --no-banner --redact --exit-code 1 --log-opts="$range" . >/dev/null 2>&1; then
			echo "Error: gitleaks found a secret in the commits being pushed." >&2
			fail=1
		fi
	else
		echo "Error: gitleaks is not installed, so the push was not scanned for secrets: brew install gitleaks" >&2
		fail=1
	fi
done
exit $fail
